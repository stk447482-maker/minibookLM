    {
      "id": "art_1791980788413",
      "projectId": "proj_1791372845616",
      "type": "graph3d",
      "title": "3D ナレッジグラフデータ",
      "content": "```json\n{\n  \"nodes\": [\n    {\"id\": \"1\", \"name\": \"工事工程・機器搬入調整\", \"val\": 100, \"color\": \"#1e3a8a\"},\n    {\"id\": \"2\", \"name\": \"建築工程\", \"val\": 80, \"color\": \"#1e3a8a\"},\n    {\"id\": \"3\", \"name\": \"大型機器搬入\", \"val\": 80, \"color\": \"#1e3a8a\"},\n    {\"id\": \"4\", \"name\": \"多工種輻輳（11月〜12月）\", \"val\": 70, \"color\": \"#ef4444\"},\n    {\"id\": \"5\", \"name\": \"土間コンクリート打設\", \"val\": 60, \"color\": \"#10b981\"},\n    {\"id\": \"6\", \"name\": \"配管支持（アングル取付）\", \"val\": 70, \"color\": \"#10b981\"},\n    {\"id\": \"7\", \"name\": \"ピット工事\", \"val\": 60, \"color\": \"#f59e0b\"},\n    {\"id\": \"8\", \"name\": \"ピット外エリア（乾燥炉・ブース等）\", \"val\": 50, \"color\": \"#6366f1\"},\n    {\"id\": \"9\", \"name\": \"ピット内機器\", \"val\": 50, \"color\": \"#6366f1\"},\n    {\"id\": \"10\", \"name\": \"外部足場解体\", \"val\": 40, \"color\": \"#ec4899\"},\n    {\"id\": \"11\", \"name\": \"貯水槽基礎工事\", \"val\": 40, \"color\": \"#ec4899\"},\n    {\"id\": \"12\", \"name\": \"上野電機\", \"val\": 30, \"color\": \"#8b5cf6\"}\n  ],\n  \"links\": [\n    {\"source\": \"1\", \"target\": \"2\", \"label\": \"整合性確保\"},\n    {\"source\": \"1\", \"target\": \"3\", \"label\": \"整合性確保\"},\n    {\"source\": \"2\", \"target\": \"4\", \"label\": \"期間重複\"},\n    {\"source\": \"6\", \"target\": \"5\", \"label\": \"先行完了必須\"},\n    {\"source\": \"3\", \"target\": \"8\", \"label\": \"先行搬入方針\"},\n    {\"source\": \"3\", \"target\": \"9\", \"label\": \"後続搬入方針\"},\n    {\"source\": \"7\", \"target\": \"3\", \"label\": \"遅延による影響\"},\n    {\"source\": \"10\", \"target\": \"11\", \"label\": \"施工阻害要因\"},\n    {\"source\": \"12\", \"target\": \"3\", \"label\": \"搬入動線調整\"}\n  ]\n}\n```",
