      "title": "実務プロセス・判断フローチャート",
      "content": "flowchart TD\n  step_1[\"業務開始・作業計画の策定\"]\n  step_2{\"対象ガス設備の内容積・バルブ構成・作業内容の確認\"}\n  step_2 -- \"Yes\" --> step_3\n  step_2 -- \"No\" --> step_alt_2[\"置換省略不可：完全なガス置換プロセスへ移行\"]\n  step_3{\"置換省略要件チェック（内容積1m³以下/バルブ2個以上/非入\"}\n  step_3 -- \"Yes\" --> step_4\n  step_3 -- \"No\" --> step_alt_3[\"標準ガス置換手順の適用\"]\n  step_4[\"不活性ガス等によるガス置換の実施\"]\n  step_5{\"作業員入室の有無を確認\"}\n  step_5 -- \"Yes\" --> step_6\n  step_5 -- \"No\" --> step_alt_5[\"次ステップへ\"]\n  step_6{\"内部残留ガス・液体の安全性確認（空気混合時の安全性）\"}\n  step_6 -- \"Yes\" --> step_7\n  step_6 -- \"No\" --> step_alt_6[\"不適合：追加のガス置換・パージの実施\"]\n  step_7{\"空気による再置換の完了確認\"}\n  step_7 -- \"Yes\" --> step_8\n  step_7 -- \"No\" --> step_alt_7[\"再置換の継続\"]\n  step_8{\"酸素濃度およびガス検知値の判定\"}\n  step_8 -- \"Yes\" --> step_9\n  step_8 -- \"No\" --> step_alt_8[\"不適合：再置換・換気・再測定\"]\n  step_9[\"修理・清掃・交換等の実作業の実行\"]\n  step_10[\"作業完了後の設備復旧・閉止確認\"]\n  step_9 --> step_10\n  step_11[\"作業記録の作成・安全管理ログの保存\"]\n  step_10 --> step_11\n  step_12[\"業務完了\"]\n  step_11 --> step_12\n",
      "createdAt": 1792311484031
